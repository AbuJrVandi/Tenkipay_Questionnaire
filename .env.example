NODE_ENV=development
PORT=3001
APP_ORIGIN=http://localhost:5173
DATABASE_URL=postgres://tenkipay:replace-with-database-password@127.0.0.1:5432/tenkipay
DATABASE_SSL=false
# Alternatively, use PGHOST, PGPORT, PGDATABASE, PGUSER and PGPASSWORD instead of DATABASE_URL.
ADMIN_EMAIL=admin@tenkipay.local
ADMIN_PASSWORD=replace-with-at-least-14-characters
# Set true only behind exactly one trusted reverse proxy.
TRUST_PROXY=false
# Official documented Adrehs API.
ADREHS_CREATE_URL=https://api.adrehs.org/addresses/generate
ADREHS_API_KEY=

# Optional deployed HTTPS respondent URL used for QR sharing (rebuild after changing).
VITE_PUBLIC_FORM_URL=
